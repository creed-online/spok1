# Normalise text files to LF in the repo
* text=auto eol=lf

# Must stay LF everywhere (they run on Linux/macOS)
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
cloud-init.yaml text eol=lf

# Windows scripts keep CRLF
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.db   binary
