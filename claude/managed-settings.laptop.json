{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/agent/.env)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(**/*.pem)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Bash(claude --dangerously-skip-permissions*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "C:\\Program Files\\spok1\\python\\cpython-3.12\\python.exe",
            "args": [
              "-I",
              "-S",
              "C:\\Program Files\\spok1\\guard\\run_guard.py",
              "--policy",
              "C:\\Program Files\\spok1\\guardrails.toml"
            ],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "spok1 guard"
          }
        ]
      }
    ]
  }
}
