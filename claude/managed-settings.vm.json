{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Read(**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/agent/.env)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(**/*.pem)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Bash(claude --dangerously-skip-permissions*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)"
    ],
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "NotebookEdit",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "mcp__plugin_discord_discord__*",
      "mcp__spok1-notify__*",
      "mcp__claude_ai_Mem0__*"
    ],
    "defaultMode": "default",
    "disableAutoMode": "disable"
  },
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/spok1/python/cpython-3.12/bin/python3",
            "args": [
              "-I",
              "-S",
              "/opt/spok1/guard/run_guard.py",
              "--policy",
              "/etc/spok1/guardrails.toml"
            ],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "spok1 guard"
          }
        ]
      }
    ]
  }
}
